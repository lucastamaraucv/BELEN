{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ORDEN BELEN - GUI (ventana)",
            "type": "debugpy",
            "request": "launch",
            "module": "orden_belen.gui",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}/src" },
            "console": "integratedTerminal"
        },
        {
            "name": "ORDEN BELEN - Headless (main)",
            "type": "debugpy",
            "request": "launch",
            "module": "orden_belen.main",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}/src" },
            "console": "integratedTerminal"
        }
    ]
}
